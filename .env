# Environment variables for Online Voting System

# Admin access code for admin page and login verification
ADMIN_ACCESS_CODE=your_secure_admin_code_here

# Session secret for express-session
SESSION_SECRET=your_session_secret_here

# Google OAuth credentials (if used)
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=your_redirect_uri_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here
GMAIL_USER_EMAIL=your_email_here
